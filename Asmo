--  RUNTIME — AUTO COLLECT CASH
--  targets CashPad parts in Workspace.Plots
-- ══════════════════════════════════════════
local cashCD = 0
RUN.Heartbeat:Connect(function()
    if not cfg.autoCash or not hrp then return end
    local now = tick()
    if now - cashCD < 0.5 then return end
    cashCD = now

    local plots = WS:FindFirstChild("Plots")
    if not plots then return end

    for _, plot in ipairs(plots:GetChildren()) do
        -- collect from CashPad
        local cashPad = plot:FindFirstChild("CashPad")
        if cashPad then
            local root = cashPad:FindFirstChildOfClass("BasePart")
            if root then
                local d = (root.Position - hrp.Position).Magnitude
                if d < 180 then
                    pcall(function() claimCoins:FireServer() end)
                    pcall(function() plotSell:FireServer()   end)
                end
            end
        end
    end
    -- collect dropped cash (FastOverheadTemplate in Debris)
    local debris = WS:FindFirstChild("Debris")
    if debris then
        for _, obj in ipairs(debris:GetChildren()) do
            local root = obj:FindFirstChildOfClass("BasePart")
            if root then
                local d = (root.Position - hrp.Position).Magnitude
                if d < 60 then
                    hrp.CFrame = CFrame.new(root.Position + Vector3.new(0,3,0))
                end
            end
        end
    end
end)

