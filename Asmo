local espObjs = {}

local function clearESP()
    for _, t in pairs(espObjs) do
        if t.box  and t.box.Parent  then t.box:Destroy()  end
        if t.bill and t.bill.Parent then t.bill:Destroy() end
    end
    espObjs = {}
end

local function buildESPFor(plr)
    if plr == lp or espObjs[plr] then return end
    local c = plr.Character
    if not c then return end
    local root = c:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local box = Instance.new("SelectionBox")
    box.Color3 = Color3.fromRGB(130, 55, 255)
    box.LineThickness = 0.045
    box.SurfaceTransparency = 0.8
    box.SurfaceColor3 = Color3.fromRGB(100, 35, 220)
    box.Adornee = c
    box.Parent = sg

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0,120,0,36)
    bill.StudsOffset = Vector3.new(0,3.5,0)
    bill.AlwaysOnTop = true
    bill.Adornee = root
    bill.Parent = sg

    local nl = Instance.new("TextLabel")
    nl.Size = UDim2.new(1,0,0.6,0)
    nl.BackgroundTransparency = 1
    nl.Text = plr.Name
    nl.TextColor3 = Color3.fromRGB(195,155,255)
    nl.Font = Enum.Font.GothamBold
    nl.TextSize = 13
    nl.TextStrokeTransparency = 0.3
    nl.Parent = bill

    local dl = Instance.new("TextLabel")
    dl.Size = UDim2.new(1,0,0.4,0)
    dl.Position = UDim2.new(0,0,0.6,0)
    dl.BackgroundTransparency = 1
    dl.Text = ""
    dl.TextColor3 = Color3.fromRGB(80,230,160)
    dl.Font = Enum.Font.Gotham
    dl.TextSize = 10
    dl.TextStrokeTransparency = 0.4
    dl.Parent = bill

    espObjs[plr] = {box=box, bill=bill, dist=dl, root=root}
end

RUN.Heartbeat:Connect(function()
    if not cfg.esp then
        if next(espObjs) then clearESP() end
        return
    end
    for _, plr in ipairs(PL:GetPlayers()) do
        if plr ~= lp then
            local c = plr.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                buildESPFor(plr)
                local t = espObjs[plr]
                if t and hrp then
                    local d = math.floor((t.root.Position-hrp.Position).Magnitude)
                    t.dist.Text = cfg.espDist and (d.." studs") or ""
                end
            else
                if espObjs[plr] then
                    if espObjs[plr].box  then espObjs[plr].box:Destroy()  end
                    if espObjs[plr].bill then espObjs[plr].bill:Destroy() end
                    espObjs[plr] = nil
                end
            end
        end
    end
    for plr in pairs(espObjs) do
        if not plr.Parent then
            espObjs[plr].box:Destroy(); espObjs[plr].bill:Destroy()
            espObjs[plr] = nil
        end
    end
end)
PL.PlayerRemoving:Connect(function(plr)
    if espObjs[plr] then
        espObjs[plr].box:Destroy(); espObjs[plr].bill:Destroy()
        espObjs[plr] = nil
    end
end)

-- ══════════════════════════════════════════
--  RUNTIME — STEAL (fires StealService/Grab)
-- ══════════════════════════════════════════
local stealCD = {}
RUN.Heartbeat:Connect(function()
    if not (cfg.autoSteal or cfg.instaSteal) then return end
    if not hrp or not stealGrab then return end
    local now = tick()

    for _, plr in ipairs(PL:GetPlayers()) do
        if plr == lp then continue end
        local tc = plr.Character
        if not tc then continue end
        local tRoot = tc:FindFirstChild("HumanoidRootPart")
        if not tRoot then continue end
        local dist = (tRoot.Position - hrp.Position).Magnitude
        if dist > cfg.stealRange then continue end
        if stealCD[plr] and (now - stealCD[plr]) < 1.0 then continue end
        stealCD[plr] = now

        if cfg.instaSteal then
            hrp.CFrame = tRoot.CFrame * CFrame.new(0, 0, -2.4)
            task.wait(0.04)
        end

