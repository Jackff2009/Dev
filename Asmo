-- ══════════════════════════════════════════
--  ANTI-HIT — block damage touch on __HITBOX
-- ══════════════════════════════════════════
local antiHitConn
local function startAntiHit()
    if antiHitConn then antiHitConn:Disconnect() end
    antiHitConn = RUN.Heartbeat:Connect(function()
        if not char then return end
        -- make our __HITBOX non-collidable so enemies can't register hits
        local hitbox = WS:FindFirstChild(lp.Name) and WS[lp.Name]:FindFirstChild("__HITBOX")
        if hitbox and hitbox:IsA("BasePart") then
            hitbox.CanTouch = false
            hitbox.CanCollide = false
        end
    end)
end

